def main :: IO Int = pure 5

def main :: Maybe Int =
    Just 5

def main :: Maybe (Either Int Int) = Nothing

def main :: Maybe (Either Int a) = Nothing

def main :: Maybe (Either Int a) -> Maybe (Either Int a) -> Maybe (Either Int a) -> Maybe (Either Int a) = Nothing

def main :: a b = ""

def equals :: Bool -> Bool -> Bool = true

def genericEq :: a -> a -> Bool with Eq a
    | x y => equals x y

def genericEqTest :: a -> a -> Bool with Eq a
    | x y => genericEq x y